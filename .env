# MySQL 8 (the existing multiss_ecommerce database)
DATABASE_URL="mysql://root:@127.0.0.1:3306/multiss_ecommerce"

# Auth.js
AUTH_SECRET="b8mUmHjluuqYFRT7EWkRCv7qtCLAdOCiq5XyDYc4yxU="
AUTH_URL="http://localhost:3000"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# VAT rate as a percentage (South Africa: 15)
VAT_RATE_PERCENT="15"

# Preview mode without database: renders sample catalogue data
USE_MOCK_DATA="true"

# -------------------------------------------------------------
# Backend (PHP API)
# -------------------------------------------------------------
APP_NAME=MultiSS
APP_ENV=local
APP_DEBUG=true

CORS_ALLOWED_ORIGIN=http://localhost:3000
SESSION_NAME=multiss_session

RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multiss_ecommerce
DB_USERNAME=root
