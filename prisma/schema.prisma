// Written against database/multiss_ecommerce_dev.sql (all 28 tables) + migrations/*.sql.
// Verified mechanically with scripts/check-schema.ts (compares every column to information_schema).
// The SQL files are the source of truth: DO NOT use `prisma migrate` or `prisma db push`.
// After any SQL migration, run `npm run db:pull` (then re-check this file) and `npm run db:generate`.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────

enum UserStatus {
  active
  inactive
}

enum CartStatus {
  active
  converted
  abandoned
}

enum CategoryStatus {
  active
  inactive
}

enum ProductStatus {
  draft
  active
  inactive
}

enum VariantStatus {
  active
  inactive
}

enum MovementType {
  stock_in
  sale
  return
  damage
  adjustment
}

enum OrderStatus {
  pending_payment
  payment_failed
  new
  confirmed
  processing
  completed
  cancelled
}

enum PaymentStatus {
  pending
  successful
  failed
  partially_refunded
  refunded
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum CommissionRuleStatus {
  active
  inactive
}

enum VendorOrderStatus {
  new
  confirmed
  processing
  completed
  cancelled
  refunded
}

enum PaymentAccountStatus {
  pending
  active
  inactive
  suspended
}

enum SplitStatus {
  pending
  successful
  failed
  partially_reversed
  reversed
}

enum AdjustmentType {
  refund
  manual
}

enum AdjustmentStatus {
  pending
  successful
  failed
}

enum RefundStatus {
  requested
  approved
  processing
  successful
  failed
  cancelled
}

enum DocumentType {
  company_registration
  vat
  bbbee
  tax_compliance
  id
  bank_confirmation_letter
  proof_of_address
}

enum ApplicationStatus {
  pending
  under_review
  approved
  rejected
  withdrawn
}

enum VendorType {
  multiss
  third_party
}

enum VendorStatus {
  active
  suspended
  inactive
}

enum VendorRole {
  owner
  manager
  staff
}

enum VendorUserStatus {
  active
  inactive
}

enum TokenType {
  password_reset
  email_verification
}

// ───────────── Users & access ─────────────

model User {
  id           Int        @id @default(autoincrement()) @map("user_id") @db.UnsignedInt
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(30)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(active)
  /// When the customer accepted the terms and privacy policy at registration (POPIA consent record)
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamp(0)
  createdAt    DateTime?  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  roles                 UserRole[]
  addresses             Address[]
  carts                 Cart[]
  orders                Order[]
  vendorUsers           VendorUser[]
  vendorApplications    VendorApplication[] @relation("ApplicationApplicant")
  reviewedApplications  VendorApplication[] @relation("ApplicationReviewer")
  vendorBlocks          VendorBlock[]
  inventoryMovements    InventoryMovement[]
  tokens                UserToken[]
  reviewedProducts      Product[]               @relation("ProductReviewer")
  commissionRulesMade   CommissionRule[]        @relation("CommissionCreator")
  refundsRequested      Refund[]                @relation("RefundRequester")
  refundsApproved       Refund[]                @relation("RefundApprover")
  documentsReviewed     VendorApplicationDocument[] @relation("DocumentReviewer")

  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement()) @map("role_id") @db.UnsignedInt
  name        String     @unique @map("role_name") @db.VarChar(50)
  description String?    @db.VarChar(255)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  id         Int       @id @default(autoincrement()) @map("user_role_id") @db.UnsignedInt
  userId     Int       @map("user_id") @db.UnsignedInt
  roleId     Int       @map("role_id") @db.UnsignedInt
  assignedAt DateTime? @default(now()) @map("assigned_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserToken {
  id        Int       @id @default(autoincrement()) @map("token_id") @db.UnsignedInt
  userId    Int       @map("user_id") @db.UnsignedInt
  type      TokenType @map("token_type")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(0)
  usedAt    DateTime? @map("used_at") @db.Timestamp(0)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

model Address {
  id        Int       @id @default(autoincrement()) @map("address_id") @db.UnsignedInt
  userId    Int       @map("user_id") @db.UnsignedInt
  label     String?   @map("address_label") @db.VarChar(50)
  line1     String    @map("address_line_1") @db.VarChar(150)
  line2     String?   @map("address_line_2") @db.VarChar(150)
  city      String    @db.VarChar(100)
  province  String    @db.VarChar(100)
  postalCode String   @map("postal_code") @db.VarChar(20)
  country   String    @default("South Africa") @db.VarChar(100)
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ───────────── Vendors ─────────────

model VendorApplication {
  id                     Int               @id @default(autoincrement()) @map("application_id") @db.UnsignedInt
  userId                 Int               @map("user_id") @db.UnsignedInt
  companyName            String            @map("institution_company_name") @db.VarChar(150)
  vatNumber              String            @map("vat_number") @db.VarChar(100)
  emailAddress           String            @map("email_address") @db.VarChar(255)
  primaryContactNumber   String            @map("primary_contact_number") @db.VarChar(30)
  secondaryContactNumber String?           @map("secondary_contact_number") @db.VarChar(30)
  billingAddressLine1    String            @map("billing_address_line_1") @db.VarChar(150)
  billingAddressLine2    String?           @map("billing_address_line_2") @db.VarChar(150)
  billingCity            String            @map("billing_city") @db.VarChar(100)
  billingProvince        String            @map("billing_province") @db.VarChar(100)
  billingPostalCode      String            @map("billing_postal_code") @db.VarChar(20)
  billingCountry         String            @default("South Africa") @map("billing_country") @db.VarChar(100)
  status                 ApplicationStatus @default(pending) @map("application_status")
  submittedAt            DateTime?         @default(now()) @map("submitted_at") @db.Timestamp(0)
  updatedAt              DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  reviewedAt             DateTime?         @map("reviewed_at") @db.Timestamp(0)
  reviewedById           Int?              @map("reviewed_by") @db.UnsignedInt
  reviewNotes            String?           @map("review_notes") @db.Text

  applicant User    @relation("ApplicationApplicant", fields: [userId], references: [id])
  reviewer  User?   @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  vendor    Vendor?
  documents VendorApplicationDocument[]

  @@index([userId])
  @@index([reviewedById])
  @@index([vatNumber, status])
  @@map("vendor_applications")
}

model VendorBlock {
  id          Int       @id @default(autoincrement()) @map("block_id") @db.UnsignedInt
  vatNumber   String    @map("vat_number") @db.VarChar(100)
  companyName String    @map("institution_company_name") @db.VarChar(150)
  reason      String    @db.Text
  blockedById Int       @map("blocked_by") @db.UnsignedInt
  blockedAt   DateTime? @default(now()) @map("blocked_at") @db.Timestamp(0)
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(0)
  isActive    Boolean   @default(true) @map("is_active")

  blockedBy User @relation(fields: [blockedById], references: [id])

  @@index([blockedById])
  @@index([vatNumber, isActive])
  @@map("vendor_blocks")
}

model Vendor {
  id                     Int          @id @default(autoincrement()) @map("vendor_id") @db.UnsignedInt
  applicationId          Int?         @unique @map("application_id") @db.UnsignedInt
  type                   VendorType   @default(third_party) @map("vendor_type")
  companyName            String       @map("institution_company_name") @db.VarChar(150)
  registrationNumber     String?      @unique @map("registration_number") @db.VarChar(100)
  vatNumber              String       @unique @map("vat_number") @db.VarChar(100)
  emailAddress           String       @map("email_address") @db.VarChar(255)
  primaryContactNumber   String       @map("primary_contact_number") @db.VarChar(30)
  secondaryContactNumber String?      @map("secondary_contact_number") @db.VarChar(30)
  billingAddressLine1    String       @map("billing_address_line_1") @db.VarChar(150)
  billingAddressLine2    String?      @map("billing_address_line_2") @db.VarChar(150)
  billingCity            String       @map("billing_city") @db.VarChar(100)
  billingProvince        String       @map("billing_province") @db.VarChar(100)
  billingPostalCode      String       @map("billing_postal_code") @db.VarChar(20)
  billingCountry         String       @default("South Africa") @map("billing_country") @db.VarChar(100)
  status                 VendorStatus @default(active) @map("vendor_status")
  createdAt              DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt              DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  application VendorApplication? @relation(fields: [applicationId], references: [id])
  users       VendorUser[]
  products    Product[]
  vendorOrders    VendorOrder[]
  paymentAccounts VendorPaymentAccount[]
  paymentSplits   PaymentSplit[]

  @@map("vendors")
}

model VendorUser {
  id       Int              @id @default(autoincrement()) @map("vendor_user_id") @db.UnsignedInt
  vendorId Int              @map("vendor_id") @db.UnsignedInt
  userId   Int              @map("user_id") @db.UnsignedInt
  role     VendorRole       @default(staff) @map("vendor_role")
  status   VendorUserStatus @default(active)
  joinedAt DateTime?        @default(now()) @map("joined_at") @db.Timestamp(0)

  vendor Vendor @relation(fields: [vendorId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([vendorId, userId])
  @@index([userId])
  @@map("vendor_users")
}

// ───────────── Catalogue ─────────────

model Category {
  id               Int            @id @default(autoincrement()) @map("category_id") @db.UnsignedInt
  parentCategoryId Int?           @map("parent_category_id") @db.UnsignedInt
  name             String         @map("category_name") @db.VarChar(100)
  slug             String         @unique @db.VarChar(120)
  description      String?        @db.Text
  status           CategoryStatus @default(active)
  createdAt        DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  parent   Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products ProductCategory[]
  commissionRule CommissionRule?

  @@index([parentCategoryId])
  @@map("categories")
}

model Product {
  id          Int           @id @default(autoincrement()) @map("product_id") @db.UnsignedInt
  vendorId    Int           @map("vendor_id") @db.UnsignedInt
  name        String        @map("product_name") @db.VarChar(200)
  slug        String        @unique @db.VarChar(220)
  description String?       @db.Text
  brand       String?       @db.VarChar(150)
  status      ProductStatus @default(draft) @map("product_status")
  /// Only 'approved' products may appear in the storefront.
  approvalStatus  ApprovalStatus @default(pending) @map("approval_status")
  reviewedById    Int?           @map("reviewed_by") @db.UnsignedInt
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamp(0)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(500)
  isFeatured  Boolean       @default(false) @map("is_featured")
  createdAt   DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  reviewedBy     User?                  @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  commissionRule CommissionRule?
  vendor         Vendor                 @relation(fields: [vendorId], references: [id])
  categories     ProductCategory[]
  images         ProductImage[]
  specifications ProductSpecification[]
  variants       ProductVariant[]

  @@index([vendorId])
  @@index([name])
  @@index([reviewedById])
  @@index([isFeatured, status])
  @@map("products")
}

model ProductCategory {
  productId  Int @map("product_id") @db.UnsignedInt
  categoryId Int @map("category_id") @db.UnsignedInt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        Int       @id @default(autoincrement()) @map("image_id") @db.UnsignedInt
  productId Int       @map("product_id") @db.UnsignedInt
  imageUrl  String    @map("image_url") @db.VarChar(500)
  altText   String?   @map("alt_text") @db.VarChar(255)
  isPrimary Boolean   @default(false) @map("is_primary")
  sortOrder Int       @default(0) @map("sort_order") @db.UnsignedInt
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductSpecification {
  id        Int    @id @default(autoincrement()) @map("specification_id") @db.UnsignedInt
  productId Int    @map("product_id") @db.UnsignedInt
  name      String @map("specification_name") @db.VarChar(150)
  value     String @map("specification_value") @db.VarChar(255)
  sortOrder Int    @default(0) @map("sort_order") @db.UnsignedInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

model ProductVariant {
  id             Int           @id @default(autoincrement()) @map("variant_id") @db.UnsignedInt
  productId      Int           @map("product_id") @db.UnsignedInt
  name           String        @map("variant_name") @db.VarChar(150)
  sku            String        @unique @db.VarChar(100)
  modelNumber    String?       @map("model_number") @db.VarChar(100)
  unit           String?       @db.VarChar(50)
  /// VAT-inclusive price in ZAR
  sellingPrice   Decimal       @map("selling_price") @db.Decimal(12, 2)
  /// VAT-inclusive "was" price; when higher than sellingPrice the UI shows a SALE badge
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal?      @map("cost_price") @db.Decimal(12, 2)
  status         VariantStatus @default(active) @map("variant_status")
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  movements InventoryMovement[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id              Int       @id @default(autoincrement()) @map("inventory_id") @db.UnsignedInt
  variantId       Int       @unique @map("variant_id") @db.UnsignedInt
  quantityInStock Int       @default(0) @map("quantity_in_stock") @db.UnsignedInt
  reorderLevel    Int       @default(0) @map("reorder_level") @db.UnsignedInt
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryMovement {
  id               Int          @id @default(autoincrement()) @map("movement_id") @db.UnsignedInt
  variantId        Int          @map("variant_id") @db.UnsignedInt
  type             MovementType @map("movement_type")
  quantityChange   Int          @map("quantity_change")
  previousQuantity Int          @map("previous_quantity") @db.UnsignedInt
  newQuantity      Int          @map("new_quantity") @db.UnsignedInt
  performedById    Int?         @map("performed_by") @db.UnsignedInt
  notes            String?      @db.VarChar(255)
  createdAt        DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)

  variant     ProductVariant @relation(fields: [variantId], references: [id])
  performedBy User?          @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([performedById])
  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ───────────── Cart ─────────────

model Cart {
  id        Int        @id @default(autoincrement()) @map("cart_id") @db.UnsignedInt
  userId    Int        @map("user_id") @db.UnsignedInt
  status    CartStatus @default(active) @map("cart_status")
  createdAt DateTime?  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
  order Order?

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id        Int       @id @default(autoincrement()) @map("cart_item_id") @db.UnsignedInt
  cartId    Int       @map("cart_id") @db.UnsignedInt
  variantId Int       @map("variant_id") @db.UnsignedInt
  quantity  Int       @default(1) @db.UnsignedInt
  addedAt   DateTime? @default(now()) @map("added_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ───────────── Orders & payments ─────────────

model Order {
  id             Int         @id @default(autoincrement()) @map("order_id") @db.UnsignedInt
  orderNumber    String      @unique @map("order_number") @db.VarChar(50)
  userId         Int         @map("user_id") @db.UnsignedInt
  cartId         Int         @unique @map("cart_id") @db.UnsignedInt
  /// VAT-inclusive sum of line totals
  subtotal       Decimal     @db.Decimal(12, 2)
  /// VAT contained in subtotal (informational: total × 15/115)
  vatAmount      Decimal     @default(0.00) @map("vat_amount") @db.Decimal(12, 2)
  shippingAmount Decimal     @default(0.00) @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 2)
  status         OrderStatus @default(pending_payment) @map("order_status")
  adminNotes     String?     @map("admin_notes") @db.Text
  createdAt      DateTime?   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  cart    Cart          @relation(fields: [cartId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  address OrderAddress?
  payments Payment[]
  vendorOrders VendorOrder[]
  refunds Refund[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                   Int     @id @default(autoincrement()) @map("order_item_id") @db.UnsignedInt
  orderId              Int     @map("order_id") @db.UnsignedInt
  vendorOrderId        Int     @map("vendor_order_id") @db.UnsignedInt
  variantId            Int     @map("variant_id") @db.UnsignedInt
  productName          String  @map("product_name") @db.VarChar(200)
  variantName          String  @map("variant_name") @db.VarChar(150)
  sku                  String  @db.VarChar(100)
  quantity             Int     @db.UnsignedInt
  unitPrice            Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal            Decimal @map("line_total") @db.Decimal(12, 2)
  commissionPercentage Decimal @default(0.00) @map("commission_percentage") @db.Decimal(5, 2)
  commissionAmount     Decimal @default(0.00) @map("commission_amount") @db.Decimal(12, 2)
  vendorNetAmount      Decimal @default(0.00) @map("vendor_net_amount") @db.Decimal(12, 2)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrder VendorOrder    @relation(fields: [vendorOrderId, orderId], references: [id, orderId], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  refundItems RefundItem[]

  @@index([variantId])
  @@index([orderId])
  @@index([vendorOrderId, orderId])
  @@map("order_items")
}

model OrderAddress {
  id            Int     @id @default(autoincrement()) @map("order_address_id") @db.UnsignedInt
  orderId       Int     @unique @map("order_id") @db.UnsignedInt
  recipientName String  @map("recipient_name") @db.VarChar(200)
  contactNumber String  @map("contact_number") @db.VarChar(30)
  line1         String  @map("address_line_1") @db.VarChar(150)
  line2         String? @map("address_line_2") @db.VarChar(150)
  city          String  @db.VarChar(100)
  province      String  @db.VarChar(100)
  postalCode    String  @map("postal_code") @db.VarChar(20)
  country       String  @default("South Africa") @db.VarChar(100)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("order_addresses")
}

model Payment {
  id                   Int           @id @default(autoincrement()) @map("payment_id") @db.UnsignedInt
  orderId              Int           @map("order_id") @db.UnsignedInt
  gateway              String        @map("payment_gateway") @db.VarChar(50)
  transactionReference String?       @map("transaction_reference") @db.VarChar(150)
  method               String?       @map("payment_method") @db.VarChar(50)
  amount               Decimal       @db.Decimal(12, 2)
  status               PaymentStatus @default(pending) @map("payment_status")
  paidAt               DateTime?     @map("paid_at") @db.Timestamp(0)
  createdAt            DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt            DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  splits  PaymentSplit[]
  refunds Refund[]

  @@index([orderId, status])
  @@map("payments")
}

// ───────────── Marketplace: commission, vendor orders, splits, refunds ─────────────

model CommissionRule {
  id         Int                  @id @default(autoincrement()) @map("commission_rule_id") @db.UnsignedInt
  categoryId Int?                 @unique @map("category_id") @db.UnsignedInt
  productId  Int?                 @unique @map("product_id") @db.UnsignedInt
  percentage Decimal              @map("commission_percentage") @db.Decimal(5, 2)
  status     CommissionRuleStatus @default(active)
  createdById Int?                @map("created_by") @db.UnsignedInt
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CommissionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("commission_rules")
}

model VendorOrder {
  id               Int               @id @default(autoincrement()) @map("vendor_order_id") @db.UnsignedInt
  orderId          Int               @map("order_id") @db.UnsignedInt
  vendorId         Int               @map("vendor_id") @db.UnsignedInt
  number           String            @unique @map("vendor_order_number") @db.VarChar(60)
  itemsSubtotal    Decimal           @map("items_subtotal") @db.Decimal(12, 2)
  commissionTotal  Decimal           @default(0.00) @map("commission_total") @db.Decimal(12, 2)
  vendorNetTotal   Decimal           @map("vendor_net_total") @db.Decimal(12, 2)
  status           VendorOrderStatus @default(new) @map("vendor_order_status")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items  OrderItem[]
  splits PaymentSplit[]

  @@unique([orderId, vendorId])
  @@unique([id, orderId])
  @@index([vendorId])
  @@map("vendor_orders")
}

model VendorPaymentAccount {
  id                  Int                  @id @default(autoincrement()) @map("vendor_payment_account_id") @db.UnsignedInt
  vendorId            Int                  @map("vendor_id") @db.UnsignedInt
  gateway             String               @map("payment_gateway") @db.VarChar(50)
  subaccountReference String               @map("gateway_subaccount_reference") @db.VarChar(150)
  status              PaymentAccountStatus @default(pending) @map("account_status")
  splitEnabled        Boolean              @default(false) @map("split_enabled")
  verifiedAt          DateTime?            @map("verified_at") @db.Timestamp(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  vendor Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  splits PaymentSplit[]

  @@unique([vendorId, gateway])
  @@unique([gateway, subaccountReference])
  @@map("vendor_payment_accounts")
}

model PaymentSplit {
  id                     Int         @id @default(autoincrement()) @map("payment_split_id") @db.UnsignedInt
  paymentId              Int         @map("payment_id") @db.UnsignedInt
  vendorOrderId          Int         @map("vendor_order_id") @db.UnsignedInt
  vendorId               Int         @map("vendor_id") @db.UnsignedInt
  vendorPaymentAccountId Int         @map("vendor_payment_account_id") @db.UnsignedInt
  grossAmount            Decimal     @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount       Decimal     @default(0.00) @map("commission_amount") @db.Decimal(12, 2)
  vendorAmount           Decimal     @map("vendor_amount") @db.Decimal(12, 2)
  gatewayReference       String?     @map("gateway_split_reference") @db.VarChar(150)
  status                 SplitStatus @default(pending) @map("split_status")
  processedAt            DateTime?   @map("processed_at") @db.Timestamp(0)
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamp(0)

  payment        Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  vendorOrder    VendorOrder          @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  vendor         Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paymentAccount VendorPaymentAccount @relation(fields: [vendorPaymentAccountId], references: [id], onDelete: Restrict)
  adjustments    PaymentSplitAdjustment[]

  @@unique([paymentId, vendorOrderId])
  @@index([vendorOrderId])
  @@index([vendorId])
  @@index([vendorPaymentAccountId])
  @@map("payment_splits")
}

model Refund {
  id          Int          @id @default(autoincrement()) @map("refund_id") @db.UnsignedInt
  orderId     Int          @map("order_id") @db.UnsignedInt
  paymentId   Int          @map("payment_id") @db.UnsignedInt
  reference   String       @unique @map("refund_reference") @db.VarChar(100)
  amount      Decimal      @map("refund_amount") @db.Decimal(12, 2)
  reason      String?      @map("refund_reason") @db.VarChar(500)
  status      RefundStatus @default(requested) @map("refund_status")
  requestedById Int?       @map("requested_by") @db.UnsignedInt
  approvedById  Int?       @map("approved_by") @db.UnsignedInt
  requestedAt DateTime     @default(now()) @map("requested_at") @db.Timestamp(0)
  approvedAt  DateTime?    @map("approved_at") @db.Timestamp(0)
  processedAt DateTime?    @map("processed_at") @db.Timestamp(0)

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User?   @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?   @relation("RefundApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items       RefundItem[]
  adjustments PaymentSplitAdjustment[]

  @@index([orderId])
  @@index([paymentId])
  @@index([requestedById])
  @@index([approvedById])
  @@map("refunds")
}

model RefundItem {
  id                 Int     @id @default(autoincrement()) @map("refund_item_id") @db.UnsignedInt
  refundId           Int     @map("refund_id") @db.UnsignedInt
  orderItemId        Int     @map("order_item_id") @db.UnsignedInt
  quantity           Int     @db.UnsignedInt
  amount             Decimal @map("refund_amount") @db.Decimal(12, 2)
  commissionReversal Decimal @default(0.00) @map("commission_reversal") @db.Decimal(12, 2)
  vendorReversal     Decimal @default(0.00) @map("vendor_reversal") @db.Decimal(12, 2)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  adjustments PaymentSplitAdjustment[]

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
  @@map("refund_items")
}

model PaymentSplitAdjustment {
  id                   Int              @id @default(autoincrement()) @map("adjustment_id") @db.UnsignedInt
  paymentSplitId       Int              @map("payment_split_id") @db.UnsignedInt
  refundId             Int              @map("refund_id") @db.UnsignedInt
  refundItemId         Int              @map("refund_item_id") @db.UnsignedInt
  grossAdjustment      Decimal          @map("gross_adjustment") @db.Decimal(12, 2)
  commissionAdjustment Decimal          @map("commission_adjustment") @db.Decimal(12, 2)
  vendorAdjustment     Decimal          @map("vendor_adjustment") @db.Decimal(12, 2)
  type                 AdjustmentType   @default(refund) @map("adjustment_type")
  status               AdjustmentStatus @default(pending) @map("adjustment_status")
  gatewayReference     String?          @map("gateway_adjustment_reference") @db.VarChar(150)
  processedAt          DateTime?        @map("processed_at") @db.Timestamp(0)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamp(0)

  paymentSplit PaymentSplit @relation(fields: [paymentSplitId], references: [id], onDelete: Restrict)
  refund       Refund       @relation(fields: [refundId], references: [id], onDelete: Restrict)
  refundItem   RefundItem   @relation(fields: [refundItemId], references: [id], onDelete: Restrict)

  @@unique([paymentSplitId, refundItemId])
  @@index([refundId])
  @@index([refundItemId])
  @@map("payment_split_adjustments")
}

model VendorApplicationDocument {
  id                 Int               @id @default(autoincrement()) @map("document_id") @db.UnsignedInt
  applicationId      Int               @map("application_id") @db.UnsignedInt
  type               DocumentType      @map("document_type")
  url                String            @map("document_url") @db.VarChar(500)
  verificationStatus ApprovalStatus    @default(pending) @map("verification_status")
  reviewedById       Int?              @map("reviewed_by") @db.UnsignedInt
  reviewedAt         DateTime?         @map("reviewed_at") @db.Timestamp(0)
  rejectionReason    String?           @map("rejection_reason") @db.VarChar(500)
  uploadedAt         DateTime          @default(now()) @map("uploaded_at") @db.Timestamp(0)

  application VendorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy  User?             @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([applicationId, type])
  @@index([reviewedById])
  @@map("vendor_application_documents")
}

// ───────────── Marketing ─────────────

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement()) @map("subscriber_id") @db.UnsignedInt
  email          String    @unique @db.VarChar(255)
  subscribedAt   DateTime? @default(now()) @map("subscribed_at") @db.Timestamp(0)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamp(0)

  @@map("newsletter_subscribers")
}
