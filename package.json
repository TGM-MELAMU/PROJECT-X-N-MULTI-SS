{
  "name": "multiss-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "tsx --test src/lib/*.test.ts src/lib/auth/*.test.ts src/lib/account/*.test.ts src/lib/admin/*.test.ts",
    "db:check": "tsx --env-file=.env scripts/check-catalogue.ts",
    "a11y": "node scripts/a11y-check.cjs",
    "e2e:journey": "node scripts/e2e-journey.cjs",
    "e2e:shop": "node scripts/e2e-shop.cjs",
    "e2e:auth": "node scripts/e2e-auth.cjs",
    "e2e:account": "node scripts/e2e-account.cjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@prisma/adapter-mariadb": "^6.19.3",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^1.55.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "mysql2": "^3.11.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "deepmerge-ts": "8.0.2",
    "next": {
      "postcss": "8.5.30"
    }
  }
}
