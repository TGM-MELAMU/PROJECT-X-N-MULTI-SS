# Copy to .env and fill in. Never commit .env.

# -------------------------------------------------------------
# Frontend (Next.js 15 + Prisma + Auth.js)
# -------------------------------------------------------------
# MySQL 8 (the existing multiss_ecommerce database)
DATABASE_URL="mysql://root:password@localhost:3306/multiss_ecommerce"

# Auth.js â€” generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public site URL (used in password-reset emails and PayFast return URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# VAT rate as a percentage (South Africa: 15)
VAT_RATE_PERCENT="15"

# Email (Phase 3) â€” e.g. Resend / Brevo / SES
EMAIL_FROM="MultiSS <no-reply@multiss.co.za>"
EMAIL_API_KEY=""

# PayFast (Phase 4) â€” sandbox values for development
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"
PAYFAST_RETURN_URL=""
PAYFAST_CANCEL_URL=""
PAYFAST_NOTIFY_URL=""

# -------------------------------------------------------------
# Backend (PHP API)
# -------------------------------------------------------------
APP_NAME=MultiSS
APP_ENV=local
APP_DEBUG=true

CORS_ALLOWED_ORIGIN=http://localhost:3000
SESSION_NAME=multiss_session

RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multiss_ecommerce
DB_USERNAME=root
DB_PASSWORD=

# Phase 6 delivery demo/testing
DISTANCE_PROVIDER=demo
DEMO_DISTANCE_KM=12